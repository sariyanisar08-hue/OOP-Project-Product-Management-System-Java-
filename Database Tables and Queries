--1  List all customer names with the names of products they ordered.

 select c.name,p.name from customer c
join orders o on c.cust_id =o.cust_id
join product p on p.product_id =o.product_id

--2 Display order ID, customer name, and product name for all orders.

select   o.order_id, c.name ,p.name  from orders o
JOIN customer c ON o.cust_id = c.cust_id
JOIN product p ON o.product_id = p.product_id;

--3.Show products along with the names of suppliers who supply them.

SELECT p.name AS product_name, s.name AS supplier_name
FROM product p
JOIN product_supplier ps ON p.product_id = ps.product_id
JOIN supplier s ON ps.supplier_id = s.supplier_id;

--4.List all products that have never been ordered.

SELECT p.name AS product_name
FROM product p
WHERE p.product_id NOT IN (
    SELECT product_id 
    FROM orders)

--5.Find customers who placed orders for products in the category 'Electronics'.

select c.name  from customer c
join orders o on c.cust_id=o.cust_id
join product p on p.product_id =o.product_id
where p.category='Electronics'

--6.Display each customer along with the total quantity of products they have ordered.


SELECT c.name AS customer_name, SUM(o.quantity) AS total_quantity_ordered
FROM customer c
JOIN orders o ON c.cust_id = o.cust_id
GROUP BY c.name;

--7.List product names and the number of times each has been ordered.
SELECT p.name AS product_name, COUNT(o.order_id) AS times_ordered
FROM product p
LEFT JOIN orders o ON p.product_id = o.product_id
GROUP BY p.name;

 --8.Display supplier names who supply products that have been ordered at least once.

SELECT DISTINCT s.name AS supplier_name
FROM supplier s
JOIN product_supplier ps ON s.supplier_id = ps.supplier_id
JOIN orders o ON ps.product_id = o.product_id;

 
 --9.Show all customers who ordered a product supplied by a supplier in the same city.

SELECT DISTINCT c.name AS customer_name, c.city AS customer_city, s.name AS supplier_name, s.city AS supplier_city
FROM customer c
JOIN orders o ON c.cust_id = o.cust_id
JOIN product_supplier ps ON o.product_id = ps.product_id
JOIN supplier s ON ps.supplier_id = s.supplier_id
WHERE c.city = s.city;

--10.List all suppliers who do not supply any product.

SELECT s.name AS supplier_name
FROM supplier s
LEFT JOIN product_supplier ps ON s.supplier_id = ps.supplier_id
WHERE ps.product_id IS NULL;


